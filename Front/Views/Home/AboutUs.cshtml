@{
    ViewData["Title"] = "AboutUs";
}


<!-- About Start -->
<br />
<br />

<div class="container-fluid p-0 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                    <div class="about-img position-relative overflow-hidden p-5 pe-0">
                        <img class="img-fluid w-100" src="~/ProjectFile/img/farmar.jpg">
                    </div>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                    <h1 class="display-5 mb-4">Best Organic Fruits And Vegetables</h1>
                    <p class="mb-4">
                        Welcome to Foody , your trusted source for delicious, healthy, and sustainably sourced organic food. We believe that everyone deserves access to wholesome ingredients that nourish both body and planet.  Our passion for organic practices stems from a deep respect for nature and a commitment to providing you with the highest quality products.

                        Our Story:

                        Foody was born from a simple idea: to make organic food accessible and affordable for everyone. Frustrated by the lack of fresh, organic produce in our community, we decided to take matters into our own hands.
                        we started our organic food farm then we dscided to grew up on our  farm and witnessed firsthand the benefits of organic farming.  This inspired a lifelong passion for sustainable agriculture
                        We started small working with local farmers and selling at farmers markets, and have since grown into a thriving online marketplace and a community-supported farm.
                    </p>
                    <p><i class="fa fa-check text-primary me-3"></i>Accessibility and Affordability</p>
                    <p><i class="fa fa-check text-primary me-3"></i>Community Building</p>
                    <p><i class="fa fa-check text-primary me-3"></i>Support for Local Farmers</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Firm Visit Start -->
<div class="container-fluid bg-primary bg-icon mt-5 py-6">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-md-7 wow fadeIn" data-wow-delay="0.1s">
                <h1 class="display-5 text-white mb-3">Visit Our Firm</h1>
                <p class="text-white mb-0">Come experience the heart of our organic world! We invite you to visit our farm and discover the passion that goes into growing your food.  Explore our fields, meet our friendly animals, and learn about our sustainable practices.  It's a chance to connect with nature, see where your food comes from, and taste the difference fresh, organic produce makes.  We'd love to share our farm with you – visit us soon!</p>
            </div>
            <div class="col-md-5 text-md-end wow fadeIn" data-wow-delay="0.5s">
                <a class="btn btn-lg btn-secondary rounded-pill py-3 px-5" href="">Book a farm visit</a>
            </div>
        </div>
    </div>
</div>
<!-- Firm Visit End -->