
@{
    ViewData["Title"] = "OurFeatures";
}


<!-- Feature Start -->
<div class="container-fluid bg-light bg-icon py-6">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Our Services</h1>
            <p>Discover how our expertise and commitment to excellence can help you achieve your business objectives.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/ProjectFile/img/icon-1.png" alt="">
                    <h4 class="mb-3">Product variety</h4>
                    <p class="mb-4">"We provide a wide selection of unique and hard-to-find products at competitive prices for our valued customers."</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/ProjectFile/img/icon-2.png" alt="">
                    <h4 class="mb-3">Fast delivery</h4>
                    <p class="mb-4">We provide timely delivery of your order, ensuring it arrives fresh and in perfect condition.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/ProjectFile/img/icon-3.png" alt="">
                    <h4 class="mb-3">Loyalty programs and promotions</h4>
                    <p class="mb-4">"Unlock a world of rewards and discounts with our loyalty program. Shop more, save more!"</p>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Feature End -->

