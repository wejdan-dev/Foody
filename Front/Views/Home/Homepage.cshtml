@model Front.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Homepage";
}

<div class="container-fluid p-0 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/ProjectFile/img/carousel-1.jpg" alt="Image">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-5 animated slideInDown">Savor the Flavor of Nature's Finest Organics</h1>
                                <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Products</a>
                                <a asp-action="Services" asp-controller="Home" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">Services</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/ProjectFile/img/carousel-2.jpg" alt="Image">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-5 animated slideInDown">From Our Farm to Your Table</h1>
                                <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Products</a>
                                <a asp-action="Services" asp-controller="Home" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">Services</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container-fluid bg-light bg-icon py-6 mb-5">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Customer Review</h1>
            <p>Amazing Experience with Foody.</p>
        </div>
        <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
            <div class="testimonial-item position-relative bg-white p-5 mt-4">
                <i class="fa fa-quote-left fa-3x text-primary position-absolute top-0 start-0 mt-n4 ms-5"></i>
                <p class="mb-4">"I love the wide variety of organic products available on your website. I always find what I'm looking for!"</p>
                <div class="d-flex align-items-center">
                    <img class="flex-shrink-0 rounded-circle" src="~/ProjectFile/img/testimonial-1.jpg" alt="">
                    <div class="ms-3">
                        <h5 class="mb-1">Sara Mohammad</h5>
                        <span>Journalist</span>
                    </div>
                </div>
            </div>
            <div class="testimonial-item position-relative bg-white p-5 mt-4">
                <i class="fa fa-quote-left fa-3x text-primary position-absolute top-0 start-0 mt-n4 ms-5"></i>
                <p class="mb-4">"The quality of the products is excellent and very fresh. I feel like I'm eating healthy and natural food."</p>
                <div class="d-flex align-items-center">
                    <img class="flex-shrink-0 rounded-circle" src="~/ProjectFile/img/testimonial-2.jpg" alt="">
                    <div class="ms-3">
                        <h5 class="mb-1">Rami Samer</h5>
                        <span>Author</span>
                    </div>
                </div>
            </div>
            <div class="testimonial-item position-relative bg-white p-5 mt-4">
                <i class="fa fa-quote-left fa-3x text-primary position-absolute top-0 start-0 mt-n4 ms-5"></i>
                <p class="mb-4">"Shipping is fast and reliable, my order arrived on time and the website is very easy to use."</p>
                <div class="d-flex align-items-center">
                    <img class="flex-shrink-0 rounded-circle" src="~/ProjectFile/img/testimonial-3.jpg" alt="">
                    <div class="ms-3">
                        <h5 class="mb-1">Khaled Ameer</h5>
                        <span>Engineer</span>
                    </div>
                </div>
            </div>
            <div class="testimonial-item position-relative bg-white p-5 mt-4">
                <i class="fa fa-quote-left fa-3x text-primary position-absolute top-0 start-0 mt-n4 ms-5"></i>
                <p class="mb-4">"The prices are reasonable and the packaging is excellent; the products arrived safely."</p>
                <div class="d-flex align-items-center">
                    <img class="flex-shrink-0 rounded-circle" src="~/ProjectFile/img/testimonial-4.jpg" alt="">
                    <div class="ms-3">
                        <h5 class="mb-1">Salma Zain</h5>
                        <span>Teacher</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_LatestBlogsSection" model="Model.LatestBlogPosts" />
