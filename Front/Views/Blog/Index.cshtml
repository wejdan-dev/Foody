@model List<Front.Models.BlogPost>
@{
    ViewData["Title"] = "Latest Blog";
}

<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">Latest Blog</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Homepage" class="text-body">Home</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Blog</li>
            </ol>
        </nav>
    </div>
</div>

<partial name="_LatestBlogsSection" model="Model" />
