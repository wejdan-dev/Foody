@model Front.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<br />
<br />
<br />
<br />

<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">Order Details</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Homepage">Home</a></li>
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Cart" asp-action="MyOrders">My Orders</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">#@Model.OrderId</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card p-4 h-100">
                    <h4 class="mb-3">Order Summary</h4>
                    <p class="mb-2"><strong>Order Number:</strong> #@Model.OrderId</p>
                    <p class="mb-2"><strong>Date:</strong> @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy - hh:mm tt")</p>
                    <p class="mb-2"><strong>Status:</strong> <span class="badge @Model.Status.ToBadgeClass()">@Model.StatusText</span></p>
                    <p class="mb-0"><strong>Update:</strong> @Model.StatusMessage</p>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card p-4">
                    <h4 class="mb-3">Items</h4>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.UnitPrice.ToString("0.00")JD</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.LineTotal.ToString("0.00")JD</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Grand Total</th>
                                    <th>@Model.TotalAmount.ToString("0.00")JD</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
