@model List<Front.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "My Cart";
    var total = Model.Sum(i => i.LineTotal);
}

<br />
<br />
<br />
<br />

<!-- Page Header Start -->
<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">My Cart</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Homepage">Home</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Cart</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-5">
    <div class="container">

        @if (TempData["CartMessage"] != null)
        {
            <div class="alert alert-success">@TempData["CartMessage"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h4 class="mb-4">Your cart is empty.</h4>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill py-3 px-5">Browse Products</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="d-flex align-items-center">
                                    <img src="~/ProjectFile/img/@item.ImageFileName" alt="@item.ProductName" style="width:60px;height:60px;object-fit:cover;" class="me-3 rounded">
                                    @item.ProductName
                                </td>
                                <td>@item.UnitPrice.ToString("0.00")JD</td>
                                <td style="max-width:120px;">
                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.AvailableStock" class="form-control form-control-sm me-2" style="width:70px;">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                    </form>
                                </td>
                                <td>@item.LineTotal.ToString("0.00")JD</td>
                                <td>
                                    <form asp-controller="Cart" asp-action="RemoveItem" method="post">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end align-items-center mt-4">
                <h4 class="me-4">Total: @total.ToString("0.00")JD</h4>
                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary rounded-pill py-3 px-5">Proceed to Checkout</a>
            </div>
        }
    </div>
</div>
