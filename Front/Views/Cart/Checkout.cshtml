@model List<Front.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Checkout";
    var total = Model.Sum(i => i.LineTotal);
}

<br />
<br />
<br />
<br />

<!-- Page Header Start -->
<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">Checkout</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Homepage">Home</a></li>
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Cart" asp-action="Index">Cart</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Checkout</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-5">
    <div class="container">

        @if (TempData["CartError"] != null)
        {
            <div class="alert alert-danger">@TempData["CartError"]</div>
        }

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h4 class="mb-4">Order Summary</h4>
                <ul class="list-group mb-4">
                    @foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@item.ProductName <small class="text-muted">x @item.Quantity</small></span>
                            <span>@item.LineTotal.ToString("0.00")JD</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between align-items-center fw-bold">
                        <span>Total</span>
                        <span>@total.ToString("0.00")JD</span>
                    </li>
                </ul>

                <p class="text-muted">This is a demo checkout — no real payment is processed. Clicking "Place Order" will confirm your order and update stock.</p>

                <form asp-controller="Cart" asp-action="PlaceOrder" method="post">
                    <button type="submit" class="btn btn-primary rounded-pill py-3 px-5 w-100">Place Order</button>
                </form>
            </div>
        </div>
    </div>
</div>
