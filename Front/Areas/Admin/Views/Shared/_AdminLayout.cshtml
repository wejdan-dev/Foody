@using Front.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity != null && User.Identity.IsAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser!.FullName
        : User.Identity?.Name ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Foody Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/ProjectFile/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f6f5; }
        .admin-sidebar { min-height: 100vh; background-color: #1f2a24; color: #fff; }
        .admin-sidebar a { color: #cfd8d2; display: block; padding: 12px 20px; text-decoration: none; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background-color: #2e7d32; color: #fff; }
        .admin-brand { padding: 20px; font-size: 1.4rem; font-weight: bold; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .stat-card { border-radius: 12px; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="admin-sidebar" style="width:230px;">
            <div class="admin-brand">F<span style="color:#4caf50;">oo</span>dy Admin</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa fa-chart-line me-2"></i>Dashboard</a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="fa fa-shopping-bag me-2"></i>Orders</a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="fa fa-carrot me-2"></i>Products</a>
            <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index"><i class="fa fa-envelope me-2"></i>Contact Messages</a>
            <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index"><i class="fa fa-blog me-2"></i>Blog Posts</a>
            <hr style="border-color: rgba(255,255,255,0.1);" />
            <a asp-area="" asp-controller="Home" asp-action="Homepage"><i class="fa fa-arrow-left me-2"></i>Back to Site</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link" style="color:#cfd8d2; padding: 12px 20px; text-decoration:none;">
                    <i class="fa fa-sign-out-alt me-2"></i>Logout
                </button>
            </form>
        </div>

        <div class="flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h3 class="m-0">@ViewData["Title"]</h3>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill">
                        <i class="fa fa-shopping-bag me-1"></i>Orders
                    </a>
                    <span class="text-muted">Signed in as @displayName</span>
                </div>
            </div>

            @if (TempData["AdminMessage"] != null)
            {
                <div class="alert alert-success">@TempData["AdminMessage"]</div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
