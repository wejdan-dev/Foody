@model List<Front.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
}

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Status</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Received At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No contact messages yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var message in Model)
                    {
                        <tr>
                            <td>
                                @if (message.IsRead)
                                {
                                    <span class="badge bg-success">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Unread</span>
                                }
                            </td>
                            <td>@message.Name</td>
                            <td>@message.Email</td>
                            <td>@message.Subject</td>
                            <td>@message.CreatedAt.ToString("dd MMM yyyy - hh:mm tt")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@message.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
